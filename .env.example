# FT News Monitor — configuration template
# Copy this file to .env and fill in the values for your environment.
# Lines starting with # are comments and are ignored.

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------

# Which AI backend to use: "bedrock" (default, AWS Bedrock) or "anthropic" (direct API key)
AI_PROVIDER=bedrock

# ---------------------------------------------------------------------------
# AWS Bedrock credentials (used when AI_PROVIDER=bedrock)
# ---------------------------------------------------------------------------

# Option A: Named AWS profile from ~/.aws/credentials (SSO / Azure-AD-refreshed)
AWS_PROFILE=

# Option B: Static credentials (not recommended for shared/corporate environments)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS region for Bedrock inference profiles
AWS_REGION=eu-west-1

# ---------------------------------------------------------------------------
# Model & generation settings
# ---------------------------------------------------------------------------

# Anthropic model ID (Bedrock cross-region inference profile or direct model slug)
ANTHROPIC_MODEL=eu.anthropic.claude-haiku-4-5

# Direct Anthropic API key — only used when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Maximum output tokens per Claude call (default 512; our JSON scores use < 200)
AI_MAX_TOKENS=512

# ---------------------------------------------------------------------------
# AI filter behaviour
# ---------------------------------------------------------------------------

# Max concurrent Claude calls per collection run (reduce if hitting rate limits)
AI_FILTER_MAX_PARALLEL=5

# Articles this many days old or newer bypass the keyword pre-screen unconditionally
# (set to 0 to always require a keyword match)
AI_SKIP_PRESCREEN_DAYS=7

# ---------------------------------------------------------------------------
# Article freshness & display
# ---------------------------------------------------------------------------

# Articles older than this many days are dropped by the pre-filter
MAX_AGE_DAYS=180

# Articles collected within this window are highlighted in the dashboard
HIGHLIGHT_DAYS=30

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------

# TCP port the dashboard web server listens on
DASHBOARD_PORT=8766

# Timezone used for display timestamps (IANA name, e.g. Europe/Berlin)
TIMEZONE=Europe/Berlin

# ---------------------------------------------------------------------------
# Translation
# ---------------------------------------------------------------------------

# Enable automatic translation of non-EN/DE articles to English (true/false)
TRANSLATION_ENABLED=true

# ---------------------------------------------------------------------------
# Collection sources
# ---------------------------------------------------------------------------

# Enable Bing News as a supplemental collection source (true/false)
BING_NEWS_ENABLED=true

# Enable GDELT DOC 2.0 as a third aggregator (true/false). Free, no API key.
# GDELT is IP-neutral (crawler-side index) so it complements Google/Bing.
GDELT_ENABLED=true

# ---------------------------------------------------------------------------
# Collection time window (v0.5.0)
# ---------------------------------------------------------------------------

# How far back Google News / Bing News / GDELT should look for each keyword
# query. Valid: 1h, 1d, 7d, 1m, 3m, 6m, 1y, 5y.
#
# 3m is the recommended value for daily runs: broad enough to catch late-
# indexed items, narrow enough to keep query costs modest. The one-off
# `scripts/backfill.py` script overrides this to 5y for the initial big
# historical sweep — you do not need to change this setting to run it.
COLLECTOR_TIME_WINDOW=3m
